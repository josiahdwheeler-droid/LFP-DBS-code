#!/usr/bin/env python
# -*- coding: utf-8 -*-

"""
Process LFP NWB files and calculate a rolling‑RMS analysis.

The script
    • loads an NWB file containing Neuropixels LFP data,
    • computes a smoothed rolling RMS envelope for every channel,
    • performs a paired t‑test between “spontaneous” and “stimulated” segments,
    • saves a series of diagnostic plots (raw LFP, RMS envelope, stim‑vs‑spont,
      per‑electrode scatter, global scatter, all‑electrodes comparison).
"""

# -------------------------------------------------
# IMPORTS
# -------------------------------------------------
import os
import argparse

import numpy as np
import matplotlib.pyplot as plt
from scipy.stats import ttest_rel
from scipy.ndimage import gaussian_filter  # <-- correct function name
from pynwb import NWBHDF5IO

# -------------------------------------------------
# COMMAND‑LINE ARGUMENTS / DEFAULT SETTINGS
# -------------------------------------------------
parser = argparse.ArgumentParser(
    description="Process LFP NWB files and calculate rolling RMS analysis."
)

parser.add_argument(
    "--file_path",
    type=str,
    default="probe810755803__lfp.nwb",
    help="Path to the NWB file",
)

parser.add_argument(
    "--output_dir",
    type=str,
    default="results",
    help="Directory where results will be saved",
)

args = parser.parse_args()

# -------------------------------------------------
# OUTPUT FOLDERS
# -------------------------------------------------
base_dir = args.output_dir
stim_vs_spont_dir = os.path.join(base_dir, "stim_vs___spont")
lfp_dir = os.path.join(base_dir, "lfp_analysis")
rms_dir = os.path.join(base_dir, "rolling_rms")
scatter_dir = os.path.join(base_dir, "scatter_plots")
global_dir = os.path.join(base_dir, "global_stats")

for d in [
    stim_vs_spont_dir,
    lfp_dir,
    rms_dir,
    scatter_dir,
    global_dir,
]:
    os.makedirs(d, exist_ok=True)

# -------------------------------------------------
# LOAD LFP DATA
# -------------------------------------------------
with NWBHDF5IO(args.file_path, mode="r") as io:
    nwbfile = io.read()
    print("\nAVAILABLE ACQUISITION KEYS:")
    print(list(nwbfile.acquisition.keys()))

    # Try to guess the correct acquisition key
    acquisition_keys = list(nwbfile.acquisition.keys())
    lfp_key = (
        acquisition_keys[0]
        if acquisition_keys
        else "probe810755803__lfp_data"
    )
    ts = nwbfile.acquisition[lfp_key]

    # Use first 120 000 samples (≈ 96 s at 1250 Hz) for the demo
    data = ts.data[:120_000]
    if ts.timestamps is not None:
        time = ts.timestamps[:120_000]
    else:
        time = np.arange(data.shape[0]) / ts.rate

    # Convert from volts to µV (assuming the data are stored in V)
    unit = "µV"
    data = data * 1e6  # V → µV
    print("\nDATA SHAPE:", data.shape)  # (samples, channels)

# -------------------------------------------------
# HELPERS
# -------------------------------------------------
def compute_rms(x):
    """Root‑mean‑square of a 1‑D array."""
    return np.sqrt(np.mean(np.square(x)))


def rolling_rms(signal, window=12_000):
    """Compute a smoothed rolling RMS envelope."""
    # raw (un‑smoothed) RMS via moving‑average of the squared signal
    rms = np.sqrt(
        np.convolve(signal ** 2, np.ones(window) / window, mode="same")
    )
    # optional Gaussian smoothing (sigma in samples)
    rms = gaussian_filter(rms, sigma=1500)
    return rms


# -------------------------------------------------
# SEGMENT SETTINGS
# -------------------------------------------------
num_segments = 12                                     # split the recording
segment_len = data.shape[0] // num_segments           # samples per segment

control_segments = []   # spontaneous (first half)
stim_segments = []      # stimulated  (second half)

electrode_ids = []      # will hold the channel numbers we keep

# -------------------------------------------------
# MAIN LOOP – PROCESS EACH ELECTRODE
# -------------------------------------------------
for ch in range(data.shape[1]):               # loop over columns (channels)
    signal = data[:, ch]

    # Skip dead/noisy channels
    if np.std(signal) < 0.01:
        continue

    electrode_ids.append(ch)

    # ---- SEGMENT THE SIGNAL -------------------------------------------------
    segments = [
        signal[i * segment_len : (i + 1) * segment_len] for i in range(num_segments)
    ]
    time_segments = [
        time[i * segment_len : (i + 1) * segment_len] for i in range(num_segments)
    ]

    # first half = control, second half = stim (adjust if your protocol differs)
    control_segments.extend(segments[: num_segments // 2])
    stim_segments.extend(segments[num_segments // 2 :])

# -------------------------------------------------
# RMS VALUES PER SEGMENT
# -------------------------------------------------
control_rms = np.array([compute_rms(seg) for seg in control_segments])
stim_rms = np.array([compute_rms(seg) for seg in stim_segments])

# Paired statistics (one control segment ↔ one stim segment)
paired_control = []
paired_stim = []
for ctrl, stim in zip(control_rms, stim_rms):
    paired_control.append(ctrl)
    paired_stim.append(stim)

paired_control = np.array(paired_control)
paired_stim = np.array(paired_stim)

# -------------------------------------------------
# STATISTICAL TEST
# -------------------------------------------------
t_stat, p_val = ttest_rel(paired_control, paired_stim)

# -------------------------------------------------
# PLOTTING SETTINGS
# -------------------------------------------------
downsample = 15                      # for faster figure rendering
unit = "µV"

# ------------------------------------------------------------------
# 1. RAW LFP GRAPH (per electrode)
# ------------------------------------------------------------------
for idx, ch in enumerate(electrode_ids):
    signal = data[:, ch]
    plot_time = time[::downsample]
    plot_signal = signal[::downsample]

    plt.figure(figsize=(12, 4))
    plt.plot(plot_time, plot_signal, linewidth=0.4)
    plt.title(f"Raw LFP – Electrode {ch}")
    plt.xlabel("Time (s)")
    plt.ylabel(f"LFP Amplitude ({unit})")
    plt.tight_layout()
    plt.savefig(os.path.join(lfp_dir, f"raw_lfp_electrode_{ch}.png"), dpi=300)
    plt.close()

# ------------------------------------------------------------------
# 2. ROLLING RMS ENVELOPE (per electrode)
# ------------------------------------------------------------------
for ch in electrode_ids:
    signal = data[:, ch]
    rms = rolling_rms(signal)

    rms_time = time[: len(rms) : downsample]
    rms_plot = rms[::downsample]

    plt.figure(figsize=(12, 4))
    plt.plot(rms_time, rms_plot, linewidth=3, color="#1f77b4")
    plt.title(f"Rolling RMS – Electrode {ch}")
    plt.xlabel("Time (s)")
    plt.ylabel(f"Rolling RMS ({unit})")
    plt.tight_layout()
    plt.savefig(os.path.join(rms_dir, f"rolling_rms_electrode_{ch}.png"), dpi=300)
    plt.close()

# ------------------------------------------------------------------
# 3. STIM vs SPONTANEOUS (first segment of each class)
# ------------------------------------------------------------------
window_size = 1000  # samples used for a short “zoom‑in” view

# pick the first control and first stim segment for illustration
ctrl_seg = control_segments[0]
stim_seg = stim_segments[0]

# time vectors aligned to segment start
ctrl_time = np.arange(len(ctrl_seg)) / ts.rate
stim_time = np.arange(len(stim_seg)) / ts.rate

# smooth for visual clarity
ctrl_smooth = gaussian_filter(ctrl_seg, sigma=20)
stim_smooth = gaussian_filter(stim_seg, sigma=20)

plt.figure(figsize=(8, 6))
plt.plot(ctrl_time[:window_size], ctrl_smooth[:window_size],
         color="blue", linewidth=2, label="Spontaneous")
plt.plot(stim_time[:window_size], stim_smooth[:window_size],
         color="darkorange", linewidth=2, label="Stimulated")
plt.axvline(0, color="black", linestyle="--", linewidth=1.5)
plt.text(
    0.02,
    0.95,
    f"Spont RMS: {np.mean(paired_control):.2f} {unit}\n"
    f"Stim RMS:  {np.mean(paired_stim):.2f} {unit}\n"
    f"p = {p_val:.3e}",
    transform=plt.gca().transAxes,
    verticalalignment="top",
)
plt.title(f"Electrode {electrode_ids[0]} – Stim vs Spont")
plt.xlabel("Time (s)")
plt.ylabel(f"LFP Amplitude ({unit})")
plt.legend()
plt.tight_layout()
plt.savefig(os.path.join(stim_vs_spont_dir,
                         f"stim_vs_spont_electrode_{electrode_ids[0]}.png"),
            dpi=300)
plt.close()

# ------------------------------------------------------------------
# 4. PER‑ELECTRODE SCATTER (paired RMS values)
# ------------------------------------------------------------------
jitter_ctrl = np.random.normal(0, 0.03, len(paired_control))
jitter_stim = np.random.normal(0, 0.03, len(paired_stim))

plt.figure(figsize=(6, 6))
plt.scatter(0 + jitter_ctrl, paired_control,
            color="red", alpha=0.8, s=60, label="Spontaneous")
plt.scatter(1 + jitter_stim, paired_stim,
            color="green", alpha=0.8, s=60, label="Stimulated")

# line joining each pair
for i in range(len(paired_control)):
    plt.plot([0, 1],
             [paired_control[i], paired_stim[i]],
             color="gray", alpha=0.25)

# mean line
plt.plot([0, 1],
         [np.mean(paired_control), np.mean(paired_stim)],
         color="black", linewidth=2)

plt.xticks([0, 1], ["Spontaneous", "Stimulated"])
plt.ylabel(f"RMS Amplitude ({unit})")
plt.title(f"Per‑electrode RMS (p = {p_val:.3e})")
plt.legend()
plt.tight_layout()
plt.savefig(os.path.join(scatter_dir, "per_electrode_scatter.png"), dpi=300)
plt.close()

# ------------------------------------------------------------------
# 5. GLOBAL STATISTICS (print + overall scatter)
# ------------------------------------------------------------------
print("\n==============================")
print("GLOBAL RESULTS")
print("==============================")
print(f"Spontaneous Mean RMS: {np.mean(paired_control):.2f} {unit}")
print(f"Stimulated Mean RMS:   {np.mean(paired_stim):.2f} {unit}")
print(f"P‑value: {p_val:.3e}")

if p_val < 0.05:
    print("\nRESULT: SIGNIFICANT")
else:
    print("\nRESULT: NOT SIGNIFICANT")

# Global scatter (all electrodes as paired points)
jitter = np.random.normal(0, 0.03, len(paired_control))

plt.figure(figsize=(8, 6))
plt.scatter(0 + jitter, paired_control,
            color="red", s=60, alpha=0.8, label="Spontaneous")
plt.scatter(1 + jitter, paired_stim,
            color="green", s=60, alpha=0.8, label="Stimulated")

for i in range(len(paired_control)):
    plt.plot([0, 1],
             [paired_control[i], paired_stim[i]],
             color="gray", alpha=0.25)

plt.plot([0, 1],
         [np.mean(paired_control), np.mean(paired_stim)],
         color="black", linewidth=3)

plt.xticks([0, 1], ["Spontaneous", "Stimulated"])
plt.ylabel(f"Mean RMS per Electrode ({unit})")
plt.title(f"Global RMS Comparison (p = {p_val:.3e})")
plt.legend()
plt.tight_layout()
plt.savefig(os.path.join(global_dir, "global_scatter.png"), dpi=300)
plt.close()

# ------------------------------------------------------------------
# 6. ALL ELECTRODES COMPARISON (paired lines per electrode)
# ------------------------------------------------------------------
plt.figure(figsize=(14, 6))
plt.scatter(electrode_ids, paired_control,
            color="red", s=45, alpha=0.8, label="Spontaneous")
plt.scatter(electrode_ids, paired_stim,
            color="green", s=45, alpha=0.8, label="Stimulated")

for i, ch in enumerate(electrode_ids):
    plt.plot([ch, ch],
             [paired_control[i], paired_stim[i]],
             color="gray", alpha=0.3)

plt.xlabel("Electrode Number")
plt.ylabel(f"Mean RMS ({unit})")
plt.title(f"RMS Comparison Across All Electrodes (p = {p_val:.3e})")
plt.legend()
plt.tight_layout()
plt.savefig(os.path.join(global_dir,
                         "all_electrodes_comparison.png"),
            dpi=300)
plt.close()

print("\nDONE")
print("All figures saved under:", base_dir)
